generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SHIPPER
  TRUCKER
  ADMIN
}

enum LoadStatus {
  OPEN
  BOOKED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum BookingStatus {
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  DISPUTED
  COMPLETED
  CANCELLED
}

enum TruckType {
  FOUR_WHEELER
  SIX_WHEELER_OPEN
  SIX_WHEELER_CLOSED
  TEN_WHEELER
  TRAILER
  WING_VAN
}

enum DocumentType {
  GOVERNMENT_ID
  LTFRB_CERTIFICATE
  VEHICLE_OR_CR
  CARGO_INSURANCE
  TRUCK_PHOTO
  DRIVER_LICENSE
  SEC_REGISTRATION
  BIR_TIN
  DELIVERY_PHOTO
  BOL_DOCUMENT
  EPOD_PHOTO
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  WITHDRAWN
  EXPIRED
}

enum BOLStatus {
  DRAFT
  SIGNED
  DISPUTED
}

enum IncidentType {
  BREAKDOWN
  ROAD_CLOSURE
  TRAFFIC_DELAY
  WEATHER
  ACCIDENT
  OTHER
}

enum PaymentMethod {
  GCASH
  BANK_TRANSFER
  CORPORATE_CREDIT
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  ESCROW_HELD
  RELEASED
  REFUNDED
  FAILED
}

enum DeliveryStatus {
  FULL
  PARTIAL
  REFUSED
  FAILED
}

// ─── Core Models ─────────────────────────────────────────────

model User {
  id                String          @id @default(cuid())
  email             String?         @unique
  phone             String?         @unique
  name              String?
  role              UserRole?
  emailVerified     DateTime?
  image             String?
  preferredLanguage String          @default("en")
  onboardingStep    Int             @default(0)
  isActive          Boolean         @default(true)
  deactivatedAt     DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  shipperProfile    ShipperProfile?
  truckerProfile    TruckerProfile?
  accounts          Account[]
  sessions          Session[]
  sentMessages      Message[]       @relation("sender")
  documents         Document[]
  reviewsGiven      Review[]        @relation("ReviewsGiven")
  reviewsReceived   Review[]        @relation("ReviewsReceived")
  notifications     Notification[]
  disputesFiled     Dispute[]       @relation("DisputesFiled")
  disputesResolved  Dispute[]       @relation("DisputesResolved")
  cancellations     CancellationLog[]
  savedAddresses    SavedAddress[]
  notificationPref  NotificationPreference?
  routeAlerts       RouteAlert[]
  subscription      Subscription?
  referralCode      ReferralCode?
  referralsMade     Referral[]        @relation("ReferralsMade")
  referralsReceived Referral[]        @relation("ReferralsReceived")
}

model ShipperProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  businessName    String
  businessType    String
  businessAddress String
  gcashNumber     String?

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  loads           Load[]
  contracts       ContractLane[] @relation
  savedCarriers   SavedCarrier[]
}

model TruckerProfile {
  id                 String          @id @default(cuid())
  userId             String          @unique
  ltfrbAccreditation String?
  gcashNumber        String?
  currentLat         Float?
  currentLng         Float?
  isAvailable        Boolean         @default(true)
  homeBaseLat        Float?
  homeBaseLng        Float?
  preferredRegions   String[]
  experienceTags     String[]
  completedTrips     Int             @default(0)

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  trucks             Truck[]
  bookings           Booking[]
  backhaulOffers     BackhaulOffer[]
  bids               Bid[]
  contracts          ContractLane[]  @relation
  savedByShippers    SavedCarrier[]

  @@index([isAvailable])
}

model Truck {
  id               String       @id @default(cuid())
  truckerProfileId String
  plateNumber      String       @unique
  truckType        TruckType
  capacityTons     Float
  lengthFt         Float?
  widthFt          Float?
  heightFt         Float?
  photoUrl         String?
  isVerified       Boolean      @default(false)
  createdAt        DateTime     @default(now())

  truckerProfile   TruckerProfile @relation(fields: [truckerProfileId], references: [id], onDelete: Cascade)
}

// ─── Load & Booking ──────────────────────────────────────────

model Load {
  id                String     @id @default(cuid())
  shipperProfileId  String
  originAddress     String
  originLat         Float
  originLng         Float
  destAddress       String
  destLat           Float
  destLng           Float
  cargoType         String
  weightTons        Float
  lengthFt          Float?
  widthFt           Float?
  heightFt          Float?
  preferredTruck    TruckType?
  pickupDate        DateTime
  rateEstimate      Float?
  distanceKm        Float?
  status            LoadStatus @default(OPEN)
  specialHandling   String[]
  maxBudget         Float?
  isBackhaulRequest Boolean    @default(false)
  templateName      String?
  isTemplate        Boolean    @default(false)
  biddingDeadline   DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  shipperProfile    ShipperProfile @relation(fields: [shipperProfileId], references: [id])
  booking           Booking?
  stops             LoadStop[]
  bids              Bid[]

  @@index([status, pickupDate])
  @@index([shipperProfileId])
}

model LoadStop {
  id       String @id @default(cuid())
  loadId   String
  load     Load   @relation(fields: [loadId], references: [id], onDelete: Cascade)
  sequence Int
  address  String
  lat      Float
  lng      Float
  notes    String?

  @@index([loadId])
  @@unique([loadId, sequence])
}

model Booking {
  id                   String         @id @default(cuid())
  loadId               String         @unique
  truckerProfileId     String
  agreedRate           Float
  platformFeeShipper   Float
  platformFeeTrucker   Float
  status               BookingStatus  @default(CONFIRMED)
  waybillNumber        String         @unique @default(cuid())
  epodPhotoUrl         String?
  epodConfirmedAt      DateTime?
  epodSignature        String?
  epodDamageNotes      String?
  epodDamagePhotos     String[]
  epodMissingItems     String?
  epodDeliveryStatus   DeliveryStatus @default(FULL)
  failedDeliveryReason String?
  failedDeliveryAt     DateTime?
  payoutStatus         String?
  payoutAmount         Float?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  load                 Load           @relation(fields: [loadId], references: [id])
  truckerProfile       TruckerProfile @relation(fields: [truckerProfileId], references: [id])
  messages             Message[]
  trackingPoints       TrackingPoint[]
  billOfLading         BillOfLading?
  incidentReports      IncidentReport[]
  payments             Payment[]
  reviews              Review[]
  disputes             Dispute[]
  insurancePolicy      InsurancePolicy?
  cancellationLog      CancellationLog[]

  @@index([status])
  @@index([truckerProfileId])
}

// ─── Bidding ─────────────────────────────────────────────────

model Bid {
  id           String         @id @default(cuid())
  loadId       String
  load         Load           @relation(fields: [loadId], references: [id], onDelete: Cascade)
  truckerId    String
  trucker      TruckerProfile @relation(fields: [truckerId], references: [id])
  proposedRate Float
  comments     String?
  status       BidStatus      @default(PENDING)
  counterRate  Float?
  counterNote  String?
  respondedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([loadId])
  @@index([truckerId])
}

// ─── Documents & BOL ─────────────────────────────────────────

model Document {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        DocumentType
  fileName    String
  fileUrl     String
  fileSize    Int
  status      DocumentStatus @default(PENDING)
  verifiedAt  DateTime?
  metadata    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId, type])
}

model BillOfLading {
  id                  String    @id @default(cuid())
  bookingId           String    @unique
  booking             Booking   @relation(fields: [bookingId], references: [id])
  referenceNumber     String    @unique
  cargoDescription    String
  declaredValue       Float?
  sealNumber          String?
  specialInstructions String?
  discrepancyNotes    String?
  shipperSignature    String?
  signedAt            DateTime?
  preLoadPhotos       String[]
  status              BOLStatus @default(DRAFT)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ─── Tracking & Incidents ────────────────────────────────────

model TrackingPoint {
  id        String   @id @default(cuid())
  bookingId String
  lat       Float
  lng       Float
  timestamp DateTime @default(now())

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, timestamp])
}

model IncidentReport {
  id          String       @id @default(cuid())
  bookingId   String
  booking     Booking      @relation(fields: [bookingId], references: [id])
  type        IncidentType
  description String?
  lat         Float?
  lng         Float?
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@index([bookingId])
}

// ─── Payments ────────────────────────────────────────────────

model Payment {
  id               String        @id @default(cuid())
  bookingId        String
  booking          Booking       @relation(fields: [bookingId], references: [id])
  payerId          String
  payeeId          String
  amount           Float
  platformFee      Float
  netAmount        Float
  method           PaymentMethod @default(GCASH)
  status           PaymentStatus @default(PENDING)
  escrowHeldAt     DateTime?
  escrowReleasedAt DateTime?
  receiptNumber    String?       @unique
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([bookingId])
  @@index([payerId])
  @@index([payeeId])
}

// ─── Reviews ─────────────────────────────────────────────────

model Review {
  id                    String   @id @default(cuid())
  bookingId             String
  booking               Booking  @relation(fields: [bookingId], references: [id])
  reviewerId            String
  reviewer              User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  revieweeId            String
  reviewee              User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  onTimeRating          Int
  cargoCareRating       Int
  communicationRating   Int
  professionalismRating Int
  overallRating         Float
  comment               String?
  response              String?
  respondedAt           DateTime?
  isFlagged             Boolean  @default(false)
  flagReason            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([bookingId, reviewerId])
  @@index([revieweeId])
}

// ─── Notifications ───────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ─── Disputes ───────────────────────────────────────────────

model Dispute {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id])
  filedById       String
  filedBy         User          @relation("DisputesFiled", fields: [filedById], references: [id])
  type            DisputeType
  description     String
  evidencePhotos  String[]
  evidenceNotes   String?
  counterEvidence String?
  counterPhotos   String[]
  status          DisputeStatus @default(OPEN)
  resolution      String?
  resolvedById    String?
  resolvedBy      User?         @relation("DisputesResolved", fields: [resolvedById], references: [id])
  resolvedAt      DateTime?
  appealedAt      DateTime?
  appealReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([bookingId])
  @@index([status])
}

enum DisputeType {
  CARGO_DAMAGE
  LATE_DELIVERY
  DETENTION_FEE
  CARGO_MISREPRESENTATION
  NO_SHOW
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  APPEALED
  CLOSED
}

// ─── Insurance ──────────────────────────────────────────────

model InsurancePolicy {
  id            String          @id @default(cuid())
  bookingId     String          @unique
  booking       Booking         @relation(fields: [bookingId], references: [id])
  tier          InsuranceTier
  declaredValue Float
  premium       Float
  coverageMax   Float
  status        InsuranceStatus @default(ACTIVE)
  claimFiledAt  DateTime?
  claimNotes    String?
  claimPhotos   String[]
  claimStatus   String?
  createdAt     DateTime        @default(now())

  @@index([bookingId])
}

enum InsuranceTier {
  BASIC
  COMPREHENSIVE
}

enum InsuranceStatus {
  ACTIVE
  CLAIMED
  EXPIRED
  VOID
}

// ─── Contracts ──────────────────────────────────────────────

model ContractLane {
  id                   String         @id @default(cuid())
  shipperId            String
  shipper              ShipperProfile @relation(fields: [shipperId], references: [id])
  truckerId            String
  trucker              TruckerProfile @relation(fields: [truckerId], references: [id])
  originCity           String
  destCity             String
  agreedRate           Float
  fuelSurchargeFormula String?
  startDate            DateTime
  endDate              DateTime
  noticePeriodDays     Int            @default(30)
  status               ContractStatus @default(ACTIVE)
  signedByShipper      DateTime?
  signedByTrucker      DateTime?
  terminatedAt         DateTime?
  terminationReason    String?
  documentUrl          String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([shipperId])
  @@index([truckerId])
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  TERMINATED
  EXPIRED
}

// ─── Subscriptions ──────────────────────────────────────────

model Subscription {
  id        String             @id @default(cuid())
  userId    String             @unique
  user      User               @relation(fields: [userId], references: [id])
  plan      SubscriptionPlan
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?
  amount    Float
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

enum SubscriptionPlan {
  FREE
  FLEET_PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}

// ─── Cancellations ──────────────────────────────────────────

model CancellationLog {
  id            String   @id @default(cuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id])
  cancelledById String
  cancelledBy   User     @relation(fields: [cancelledById], references: [id])
  reason        String
  penaltyAmount Float    @default(0)
  isWaived      Boolean  @default(false)
  refundStatus  String?
  createdAt     DateTime @default(now())

  @@index([bookingId])
  @@index([cancelledById])
}

// ─── Saved Data ─────────────────────────────────────────────

model SavedAddress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  address   String
  lat       Float
  lng       Float
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model SavedCarrier {
  id        String   @id @default(cuid())
  shipperId String
  carrierId String
  notes     String?
  createdAt DateTime @default(now())

  shipper   ShipperProfile @relation(fields: [shipperId], references: [id], onDelete: Cascade)
  carrier   TruckerProfile @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@unique([shipperId, carrierId])
  @@index([shipperId])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  push      Json
  sms       Json
  email     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Route Alerts ───────────────────────────────────────────

model RouteAlert {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  originCity String
  destCity   String
  truckType  TruckType?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([originCity, destCity])
}

// ─── Referrals ──────────────────────────────────────────────

model ReferralCode {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String   @unique
  usageCount Int      @default(0)
  totalBonus Float    @default(0)
  createdAt  DateTime @default(now())
}

model Referral {
  id          String    @id @default(cuid())
  referrerId  String
  referredId  String
  code        String
  bonusAmount Float
  bonusPaidAt DateTime?
  firstTripAt DateTime?
  createdAt   DateTime  @default(now())

  referrer    User      @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referred    User      @relation("ReferralsReceived", fields: [referredId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId])
  @@index([referrerId])
}

// ─── Backhaul ────────────────────────────────────────────────

model BackhaulOffer {
  id               String    @id @default(cuid())
  truckerProfileId String
  originAddress    String
  originLat        Float
  originLng        Float
  destAddress      String
  destLat          Float
  destLng          Float
  truckType        TruckType
  availableTons    Float
  discountedRate   Float
  departureTime    DateTime
  expiresAt        DateTime
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())

  truckerProfile   TruckerProfile @relation(fields: [truckerProfileId], references: [id])

  @@index([isActive, expiresAt])
}

// ─── Messaging ───────────────────────────────────────────────

model Message {
  id        String   @id @default(cuid())
  bookingId String
  senderId  String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender    User     @relation("sender", fields: [senderId], references: [id])

  @@index([bookingId, createdAt])
}

// ─── Reference Data ──────────────────────────────────────────

model TruckBanWindow {
  id                 String      @id @default(cuid())
  zoneName           String
  dayOfWeek          Int[]
  startTime          String
  endTime            String
  truckTypesAffected TruckType[]
  source             String
  isActive           Boolean     @default(true)
  updatedAt          DateTime    @updatedAt

  @@index([isActive])
}

model RateConfig {
  id                      String    @id @default(cuid())
  truckType               TruckType @unique
  baseRatePerKm           Float
  fuelSurchargeMultiplier Float     @default(1.0)
  platformFeeShipperPct   Float     @default(0.035)
  platformFeeTruckerPct   Float     @default(0.06)
  updatedAt               DateTime  @updatedAt
}

// ─── NextAuth Models ─────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
